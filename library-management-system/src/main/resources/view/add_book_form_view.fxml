<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXComboBox?>
<?import com.jfoenix.controls.JFXTextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="379.0" prefWidth="858.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AddBookFormController">
   <children>
      <Label layoutX="343.0" layoutY="32.0" text="Add Book" underline="true">
         <font>
            <Font name="System Bold" size="31.0" />
         </font>
      </Label>
      <JFXTextField fx:id="txtBookTitle" layoutX="232.0" layoutY="126.0" prefHeight="26.0" prefWidth="414.0" promptText="Book Title" />
      <JFXTextField fx:id="txtAuthor" layoutX="232.0" layoutY="153.0" prefHeight="26.0" prefWidth="414.0" promptText="Author" />
      <JFXTextField fx:id="txtIsbn" layoutX="232.0" layoutY="181.0" prefHeight="26.0" prefWidth="274.0" promptText="ISBN" />
      <JFXTextField fx:id="txtNoOfCopies" layoutX="232.0" layoutY="235.0" prefHeight="26.0" prefWidth="110.0" promptText="No of Copies" />
      <JFXButton fx:id="btnAddBook" layoutX="486.0" layoutY="286.0" onAction="#btnAddBookOnClick" prefHeight="26.0" prefWidth="74.0" style="-fx-background-color: #1e3346;" text="Add Book" textFill="WHITE" />
      <JFXButton layoutX="572.0" layoutY="286.0" onAction="#btnClearFormOnClick" style="-fx-background-color: red;" text="Clear Form" textFill="WHITE" />
      <Label layoutX="232.0" layoutY="103.0" text="Book ID :">
         <font>
            <Font name="System Bold Italic" size="14.0" />
         </font>
      </Label>
      <Label fx:id="lblBookId" layoutX="299.0" layoutY="103.0" text="ID">
         <font>
            <Font name="System Bold Italic" size="14.0" />
         </font>
      </Label>
      <JFXComboBox fx:id="cmbBookCategory" layoutX="229.0" layoutY="207.0" prefHeight="26.0" prefWidth="215.0" promptText="Category" />
   </children>
</AnchorPane>
