<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXTextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="379.0" prefWidth="858.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DeleteBookFormController">
   <children>
      <Label layoutX="343.0" layoutY="52.0" text="Delete Book" underline="true">
         <font>
            <Font name="System Bold" size="31.0" />
         </font>
      </Label>
      <JFXTextField fx:id="txtBookTitle" layoutX="252.0" layoutY="171.0" prefHeight="26.0" prefWidth="414.0" promptText="Book Title" />
      <JFXTextField fx:id="txtAuthor" layoutX="252.0" layoutY="198.0" prefHeight="26.0" prefWidth="414.0" promptText="Author" />
      <JFXTextField fx:id="txtNoOfCopies" layoutX="252.0" layoutY="254.0" prefHeight="26.0" prefWidth="110.0" promptText="No of Copies" />
      <JFXButton fx:id="btnDeleteBook" layoutX="580.0" layoutY="303.0" onAction="#btnDeleteBookOnAction" opacity="0.82" prefHeight="26.0" prefWidth="85.0" style="-fx-background-color: red;" text="Delete Book" textFill="WHITE" />
      <TextField fx:id="txtIsbn" layoutX="252.0" layoutY="110.0" prefHeight="26.0" prefWidth="274.0" promptText="Enter Book ISBN " />
      <JFXButton layoutX="571.0" layoutY="110.0" onAction="#btnSearchBookOnAction" prefHeight="26.0" prefWidth="94.0" style="-fx-background-color: green;" text="Search Book" textFill="WHITE" />
      <JFXTextField fx:id="txtBookId" layoutX="252.0" layoutY="145.0" prefHeight="26.0" prefWidth="143.0" promptText="Book ID" />
      <JFXTextField fx:id="txtCategory" layoutX="252.0" layoutY="227.0" prefHeight="26.0" prefWidth="110.0" promptText="No of Copies" text="Category" />
   </children>
</AnchorPane>
